cc_library_shared {
    name: "libmmcamera_oxygen_ov12a_sunny.open",
    defaults: ["oxygen_open_camera_defaults"],
    stem: "libmmcamera_oxygen_ov12a_sunny",
    srcs: [
        "ov12a_sensor.c",
        "ov12a_sunny_sensor.c",
    ],
    local_include_dirs: ["../include"],
}

cc_library_shared {
    name: "libmmcamera_oxygen_ov12a_ofilm.open",
    defaults: ["oxygen_open_camera_defaults"],
    stem: "libmmcamera_oxygen_ov12a_ofilm",
    srcs: [
        "ov12a_sensor.c",
        "ov12a_ofilm_sensor.c",
    ],
    local_include_dirs: ["../include"],
}
